PORT=4000
JWT_SECRET=change-me
DB_PATH=./dhandha.db
# Platform commission taken from each booking (percent)
COMMISSION_PERCENT=20
# How many nearest workers get a job offer at once
OFFER_FANOUT=3
# Razorpay keys. Leave empty to use built-in MOCK payments (dev only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Minutes a worker has to respond to a job request before it moves to the next worker
OFFER_TTL_MIN=10
# SMS via Twilio. Leave empty to only log SMS to the console (dev).
DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
